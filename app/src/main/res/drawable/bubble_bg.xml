<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/umbra_bubble_pressed" />
            <stroke android:width="1dp" android:color="@color/umbra_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/umbra_bubble" />
            <stroke android:width="1dp" android:color="@color/umbra_border" />
        </shape>
    </item>
</selector>
