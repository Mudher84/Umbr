<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Umbra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/umbra_violet</item>
        <item name="colorAccent">@color/umbra_violet</item>
        <item name="colorControlActivated">@color/umbra_violet</item>
        <item name="android:windowBackground">@color/umbra_bg</item>
        <item name="android:textColorPrimary">@color/umbra_text</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="alertDialogTheme">@style/Theme.Umbra.Dialog</item>
    </style>
    <style name="Theme.Umbra.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/umbra_violet</item>
        <item name="android:windowBackground">@drawable/panel_bg</item>
    </style>
</resources>
